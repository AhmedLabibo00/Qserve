<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qserve" WindowState="Maximized" Background="{StaticResource BrushBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource BrushPrimary}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="48" Height="48" Margin="16" Background="White" CornerRadius="24">
                <TextBlock Text="Q" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="22" Foreground="{StaticResource BrushPrimary}"/>
            </Border>
            <TextBlock Grid.Column="1" Text="{DynamicResource AppName}" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="26"/>
            <Button Grid.Column="2" Style="{StaticResource TouchButton}" Content="Settings (Locked)"/>
            <Button Grid.Column="3" Style="{StaticResource TouchButton}" Content="Full Screen"/>
            <Button Grid.Column="4" Style="{StaticResource TouchButton}" Content="Close" Background="#D32F2F"/>
        </Grid>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Analytics -->
            <Border Grid.Column="0" Margin="16" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Analytics" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="Today / Week / Month" Style="{StaticResource BodyText}" Margin="0,8,0,8"/>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource CardPanel}"><TextBlock Text="Total Customers"/></Border>
                        <Border Style="{StaticResource CardPanel}"><TextBlock Text="Total Services"/></Border>
                        <Border Style="{StaticResource CardPanel}"><TextBlock Text="Average Waiting"/></Border>
                        <Border Style="{StaticResource CardPanel}"><TextBlock Text="Completed"/></Border>
                        <Border Style="{StaticResource CardPanel}"><TextBlock Text="Transferred"/></Border>
                        <Border Style="{StaticResource CardPanel}"><TextBlock Text="Cancelled"/></Border>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal"><Button Style="{StaticResource TouchButton}" Content="Export PDF"/><Button Style="{StaticResource TouchButton}" Content="Export Print"/></StackPanel>
                </StackPanel>
            </Border>

            <!-- Center: Dashboard -->
            <Border Grid.Column="1" Margin="16" Style="{StaticResource CardPanel}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Current Number" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="MR023" FontSize="84" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource BrushPrimary}"/>
                    <TextBlock Text="Remaining: 7 Customers" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Date / Time" Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Right: Services -->
            <Border Grid.Column="2" Margin="16" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Services" Style="{StaticResource TitleText}"/>
                    <UniformGrid Columns="3" Margin="0,12,0,0">
                        <Button Style="{StaticResource TouchButton}" Content="MRI / MR-### / C1 / 4m"/>
                        <Button Style="{StaticResource TouchButton}" Content="CT / CT-### / C2 / 6m"/>
                        <Button Style="{StaticResource TouchButton}" Content="US / US-### / C3 / 3m"/>
                        <Button Style="{StaticResource TouchButton}" Content="XRay / XR-### / C4 / 5m"/>
                    </UniformGrid>
                    <TextBlock Text="Tap service to generate queue + print ticket, then auto-return dashboard." Style="{StaticResource BodyText}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="12" Height="12" Fill="#9FB3C8" Margin="8"/>
            <Ellipse Width="14" Height="14" Fill="{StaticResource BrushPrimary}" Margin="8"/>
            <Ellipse Width="12" Height="12" Fill="#9FB3C8" Margin="8"/>
            <TextBlock Text="Swipe Left / Swipe Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
