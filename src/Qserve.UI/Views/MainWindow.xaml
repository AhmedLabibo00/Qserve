<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qserve" WindowState="Maximized" Background="{StaticResource BrushBackground}">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="72" Background="{StaticResource BrushPrimary}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="48" Height="48" Margin="16" Background="White" CornerRadius="24">
                <TextBlock Text="Q" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="22" Foreground="{StaticResource BrushPrimary}"/>
            </Border>
            <TextBlock Grid.Column="1" Text="{DynamicResource AppName}" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="26"/>

            <Button Grid.Column="2" Style="{StaticResource TouchButton}" Content="{DynamicResource Settings}" Background="White" Foreground="{StaticResource BrushPrimary}"/>
            <Button Grid.Column="3" Style="{StaticResource TouchButton}" Content="Full Screen"/>
            <Button Grid.Column="4" Style="{StaticResource TouchButton}" Content="Close" Background="#D32F2F"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="8">
                <Button Style="{StaticResource TouchButton}" Content="{DynamicResource CustomerScreen}"/>
                <Button Style="{StaticResource TouchButton}" Content="{DynamicResource EmployeeScreen}"/>
                <Button Style="{StaticResource TouchButton}" Content="{DynamicResource QueueDisplay}"/>
                <Button Style="{StaticResource TouchButton}" Content="{DynamicResource Settings}"/>
                <Button Style="{StaticResource TouchButton}" Content="{DynamicResource DailySummary}"/>
                <Button Style="{StaticResource TouchButton}" Content="{DynamicResource About}"/>
                <Button Style="{StaticResource TouchButton}" Content="AR"/>
                <Button Style="{StaticResource TouchButton}" Content="EN"/>
            </StackPanel>

            <Frame Grid.Column="1" Margin="16" NavigationUIVisibility="Hidden"/>
        </Grid>
    </DockPanel>
</Window>
