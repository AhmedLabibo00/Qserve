<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBackground}">
    <Grid>
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleText}" Text="{DynamicResource CustomerScreen}"/>
                <TextBlock Style="{StaticResource BodyText}" Text="Touch-friendly responsive layout placeholder for CustomerScreen." Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
